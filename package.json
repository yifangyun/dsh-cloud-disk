{
  "name": "@aicloud360/dsh-cloud-disk-bundle",
  "description": "Optional CloudDisk Host capability and sidebar bundle",
  "keywords": [
    "dsh-plugin",
    "cloud-disk",
    "360-cloud-disk"
  ],
  "version": "0.1.1-alpha.8",
  "engines": {
    "node": ">=22.19 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yifangyun/dsh-cloud-disk.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "pluginCenter": {
      "brandColor": "#2563EB"
    }
  },
  "dependencies": {
    "@aicloud360/dsh-cloud-disk": "0.1.1-alpha.8",
    "@aicloud360/dsh-cloud-disk-api-provider": "0.1.1-alpha.8",
    "@aicloud360/dsh-client-ui-cloud-disk": "0.1.1-alpha.8",
    "@aicloud360/dsh-tool-cloud-disk": "0.1.1-alpha.8"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
